{
  "viewport": { "width": 1440, "height": 900 },
  "url": "http://localhost:8501",
  "steps": [
    {
      "at": 0,
      "action": "waitFor",
      "selector": ".arb",
      "timeout": 60000,
      "note": "等待应用首屏渲染完成（冷启动可能 10-20s）"
    },
    {
      "at": 1.5,
      "action": "hover",
      "selector": "[data-testid='stSidebar'] button:has-text('精达股份 2025')",
      "settle": 900,
      "note": "鼠标移到文档按钮，让观众看清侧边栏有两份年报"
    },
    {
      "at": 3.0,
      "action": "click",
      "selector": "[data-testid='stSidebar'] button:has-text('精达股份 2025')",
      "settle": 1200,
      "note": "选择精达股份"
    },
    {
      "at": 6.0,
      "action": "click",
      "selector": "button:has-text('营业收入和归母净利润分别是多少')",
      "settle": 800,
      "note": "点击示例问题"
    },
    {
      "at": 8.0,
      "action": "waitFor",
      "selector": ".msg-ai .srcs",
      "timeout": 90000,
      "note": "等待回答完成（含引用列表），纯查数题不触发二次调用"
    },
    {
      "at": 11.0,
      "action": "click",
      "selector": ".msg-ai .cite",
      "settle": 1200,
      "note": "点击回答里的第一个引用角标（编号随检索结果变化，不写死）"
    },
    {
      "at": 14.0,
      "action": "scroll",
      "selector": "#panelBody",
      "dy": 260,
      "settle": 1400,
      "note": "滚动右侧抽屉，展示多条引用"
    },
    {
      "at": 17.0,
      "action": "click",
      "selector": "#panelBody button:has-text('查看原页')",
      "settle": 2400,
      "note": "查看 PDF 原页"
    },
    {
      "at": 21.5,
      "action": "click",
      "selector": "#panelClose",
      "settle": 900,
      "note": "关闭抽屉"
    },
    {
      "at": 23.0,
      "action": "type",
      "selector": "#input",
      "text": "那去年呢？",
      "settle": 900,
      "note": "输入追问"
    },
    {
      "at": 25.0,
      "action": "count",
      "selector": ".msg-ai",
      "note": "记录现有消息数，供下一步等待新增"
    },
    {
      "at": 25.2,
      "action": "press",
      "selector": "#input",
      "key": "Enter",
      "settle": 500
    },
    {
      "at": 26.0,
      "action": "waitNew",
      "selector": ".msg-ai .srcs",
      "timeout": 120000,
      "settle": 1200,
      "note": "等待追问的回答（必须是新增的一条）"
    },
    {
      "at": 31.0,
      "action": "click",
      "selector": "[data-testid='stSidebar'] button:has-text('时代新材 2025')",
      "settle": 2200,
      "note": "切换文档"
    },
    {
      "at": 35.0,
      "action": "click",
      "selector": "button:has-text('毛利率同比变化的原因')",
      "settle": 800,
      "note": "点击会触发扩展分析的问题"
    },
    {
      "at": 37.0,
      "action": "waitFor",
      "selector": ".msg-ai:has-text('扩展分析')",
      "timeout": 150000,
      "settle": 1500,
      "note": "等待扩展分析段落真正出现（不是只等首轮回答）"
    },
    {
      "at": 46.0,
      "action": "click",
      "selector": "#menuBtn",
      "settle": 900,
      "note": "收起侧边栏"
    },
    {
      "at": 48.0,
      "action": "click",
      "selector": "#menuBtn",
      "settle": 900,
      "note": "再展开侧边栏，展示自定义 Key 输入框"
    },
    {
      "at": 50.0,
      "action": "type",
      "selector": "input[aria-label*='DeepSeek Key']",
      "text": "sk-demo-0000000000000000",
      "press": "Enter",
      "settle": 1800,
      "note": "输入自己的 Key（Streamlit 需要回车才提交；演示用假 Key）"
    },
    {
      "at": 54.0,
      "action": "hover",
      "selector": "[data-testid='stFileUploaderDropzone']",
      "settle": 2000,
      "note": "悬停上传区，展示 40MB 上限"
    },
    {
      "at": 58.0,
      "action": "scroll",
      "selector": "#thread",
      "dy": 400,
      "settle": 1800,
      "note": "滚动对话查看完整回答"
    },
    {
      "at": 62.0,
      "action": "end"
    }
  ]
}
