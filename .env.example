DEEPSEEK_API_KEY=sk-your-key-here

# 国内网络下载向量模型建议使用镜像（部署到海外服务器时不要设）
# HF_ENDPOINT=https://hf-mirror.com

# 可选
# LLM_MODEL=deepseek-flash
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=8
# LLM_REWRITE=1

# 任一年报章节最多占用几个检索位。年报语料极度倾斜（第八节财务报告常占三分之二），
# 不限制的话 TOP_K 个位置会被财报数字占满，模型拿不到「为什么」那部分材料。
# 加大到很大等于关闭限流；调小能让来源更分散，但可能切碎一整张报表。
# MAX_PER_SECTION=5

# 给只有数字、没有年份表头的报表片段补上表头（表头在同一个子章节往前数第一个片段里）。
# 设为 0 可关闭，tools/eval_depth.py 做 A/B 时用得上。
# HEADER_PROPAGATION=1

# 生成调用的超时秒数，不设会走 OpenAI 客户端默认的 600 秒
# LLM_TIMEOUT=60

# 公开演示模式：限制提问次数和上传，上传的年报按会话隔离
# PUBLIC_DEMO=1
# SESSION_LIMIT=5
# DAILY_LIMIT=100
# MAX_PAGES=400
# MAX_UPLOADS_PER_SESSION=2
