DEEPSEEK_API_KEY=sk-your-key-here

# 国内网络下载向量模型建议使用镜像（部署到海外服务器时不要设）
# HF_ENDPOINT=https://hf-mirror.com

# 可选
# LLM_MODEL=deepseek-flash
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# TOP_K=8
# LLM_REWRITE=1

# 公开演示模式：限制提问次数和上传，上传的年报按会话隔离
# PUBLIC_DEMO=1
# SESSION_LIMIT=5
# DAILY_LIMIT=100
# MAX_PAGES=400
# MAX_UPLOADS_PER_SESSION=2
